@inject IProductService ProductService
@inject DialogService DialogService
@inject IWebHostEnvironment Env

<RadzenTemplateForm TItem="ProductDto" Data="@Model" Submit="@OnSubmit">
    <DataAnnotationsValidator />
    <RadzenTabs RenderMode="TabRenderMode.Client">
        <Tabs>
            <RadzenTabsItem Text="Details" Icon="inventory_2">
                <div class="product-editor dialog-section">
                    <div class="product-identity">
                        <div>
                            <RadzenFormField Text="SKU" Variant="Variant.Outlined" Style="width:100%">
                                <RadzenTextBox @bind-Value="Model.Sku" Name="Sku" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="Sku" Text="SKU is required" Popup="true" />
                        </div>
                        <div>
                            <RadzenFormField Text="Product name" Variant="Variant.Outlined" Style="width:100%">
                                <RadzenTextBox @bind-Value="Model.Name" Name="Name" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="Name" Text="Name is required" Popup="true" />
                        </div>
                    </div>

                    <section class="product-pricing" aria-labelledby="product-pricing-title">
                        <h3 id="product-pricing-title">Pricing &amp; tax</h3>
                        <div class="product-price-fields">
                            <RadzenFormField Text="Cost price" Variant="Variant.Outlined" Style="width:100%">
                                <RadzenNumeric @bind-Value="Model.CostPrice" Name="CostPrice" Min="0" Max="9999999" Format="0.00" Style="width:100%" />
                            </RadzenFormField>
                            <RadzenFormField Text="Default sell price" Variant="Variant.Outlined" Style="width:100%">
                                <RadzenNumeric @bind-Value="Model.SellPrice" Name="SellPrice" Min="0" Max="9999999" Format="0.00" Style="width:100%" />
                            </RadzenFormField>
                            <RadzenFormField Text="Tax category" Variant="Variant.Outlined" Style="width:100%">
                                <RadzenDropDown @bind-Value="Model.TaxCategoryId" Data="@Taxes" TextProperty="Name" ValueProperty="Id"
                                                AllowClear="true" Placeholder="No tax" />
                            </RadzenFormField>
                            <RadzenFormField Text="Reorder level" Variant="Variant.Outlined" Style="width:100%">
                                <RadzenNumeric @bind-Value="Model.ReorderLevel" Name="ReorderLevel" Min="0" Max="9999999" Format="0.###" Style="width:100%" />
                            </RadzenFormField>
                        </div>
                        <p class="product-hint" aria-live="polite">
                            All stores use the default sell price automatically unless you set a custom store price.
                            @if (CustomStorePriceCount > 0)
                            {
                                <span>@CustomStorePriceCount custom store price(s) will stay unchanged.</span>
                            }
                        </p>
                        @if (Model.SellPrice > 0)
                        {
                            <p class="product-hint">
                                Margin: @Margin().ToString("0.0")% &nbsp;·&nbsp; Markup: @(Model.CostPrice > 0 ? ((Model.SellPrice - Model.CostPrice) / Model.CostPrice * 100).ToString("0.0") + "%" : "—")
                            </p>
                        }
                    </section>

                    <details class="product-extra">
                        <summary>
                            Store prices &amp; POS visibility
                            <span class="product-summary-note">@Model.StorePrices.Count store(s) · @CustomStorePriceCount custom price(s)</span>
                        </summary>
                        <div class="product-extra-content">
                            <p class="product-hint">Edit a store price only when it differs. Choose Use default to follow future default price changes. POS visibility controls where the product can be sold.</p>
                            @if (Model.StorePrices.Count == 0)
                            {
                                <p class="product-hint">No active stores available.</p>
                            }
                            else
                            {
                                <div class="product-store-toolbar">
                                    <RadzenButton Text="Use default for all stores" Icon="restart_alt" ButtonType="ButtonType.Button"
                                                  ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                                  Disabled="@(CustomStorePriceCount == 0)" Click="@ResetStorePrices" />
                                </div>
                                @foreach (var price in Model.StorePrices)
                                {
                                    var assignment = Model.StoreAssignments.FirstOrDefault(a => a.StoreId == price.StoreId);
                                    var priceName = $"price-{price.StoreId}";
                                    <div class="product-store-row" @key="price.StoreId">
                                        <div class="product-store-name">
                                            <strong>@price.StoreName</strong>
                                            @if (assignment is not null)
                                            {
                                                <div class="product-store-visibility">
                                                    <RadzenCheckBox @bind-Value="assignment.IsVisibleOnPos" Name="@($"store-{price.StoreId}")" />
                                                    <RadzenLabel Text="Visible in POS" Component="@($"store-{price.StoreId}")" />
                                                </div>
                                            }
                                        </div>
                                        <div>
                                            <RadzenFormField Text="Store sell price" Variant="Variant.Outlined" Style="width:100%">
                                                <RadzenNumeric TValue="decimal?" Value="@(price.Price ?? Model.SellPrice)"
                                                               Change="@(value => price.Price = value)" Name="@priceName"
                                                               Min="0" Max="9999999" Format="0.00" Style="width:100%" />
                                            </RadzenFormField>
                                            <span class="product-price-source">@(price.Price.HasValue ? "Custom price" : "Uses default price")</span>
                                        </div>
                                        <RadzenButton Text="Use default" ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Light"
                                                      Size="ButtonSize.Small" Disabled="@(!price.Price.HasValue)"
                                                      Click="@(() => price.Price = null)" />
                                    </div>
                                }
                            }
                        </div>
                    </details>

                    <div class="product-fields">
                        <RadzenFormField Text="Primary barcode" Variant="Variant.Outlined" Style="width:100%">
                            <RadzenTextBox @bind-Value="Model.Barcode" Placeholder="Scan or type a barcode" />
                        </RadzenFormField>
                        <RadzenFormField Text="Category" Variant="Variant.Outlined" Style="width:100%">
                            <RadzenDropDown @bind-Value="Model.CategoryId" Data="@Categories" TextProperty="Name" ValueProperty="Id"
                                            AllowClear="true" AllowFiltering="true" Placeholder="Unassigned" />
                        </RadzenFormField>
                        <RadzenFormField Text="Brand" Variant="Variant.Outlined" Style="width:100%">
                            <RadzenDropDown @bind-Value="Model.BrandId" Data="@Brands" TextProperty="Name" ValueProperty="Id"
                                            AllowClear="true" AllowFiltering="true" Placeholder="Unassigned" />
                        </RadzenFormField>
                        <RadzenFormField Text="Unit of measure" Variant="Variant.Outlined" Style="width:100%">
                            <RadzenDropDown @bind-Value="Model.UnitId" Data="@Units" TextProperty="Name" ValueProperty="Id"
                                            AllowClear="true" Placeholder="Unassigned" />
                        </RadzenFormField>
                    </div>

                    <details class="product-extra">
                        <summary>Description &amp; image <span class="product-summary-note">Optional</span></summary>
                        <div class="product-extra-content">
                            <RadzenFormField Text="Description" Variant="Variant.Outlined" Style="width:100%">
                                <RadzenTextArea @bind-Value="Model.Description" Rows="2" />
                            </RadzenFormField>
                            <div class="product-image-upload">
                                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                                {
                                    <img src="@Model.ImageUrl" alt="Product" class="product-thumb" />
                                }
                                <label>Product image <InputFile OnChange="OnImageSelected" accept="image/*" class="file-input" /></label>
                                @if (_uploadingImage)
                                {
                                    <span class="product-hint">Uploading…</span>
                                }
                                <RadzenFormField Text="Image URL" Variant="Variant.Outlined" Style="width:100%">
                                    <RadzenTextBox @bind-Value="Model.ImageUrl" Placeholder="Or paste image URL" />
                                </RadzenFormField>
                            </div>
                        </div>
                    </details>

                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenCheckBox @bind-Value="Model.IsActive" Name="IsActive" />
                        <RadzenLabel Text="Active (available for sale)" Component="IsActive" />
                    </RadzenStack>
                </div>
            </RadzenTabsItem>

            <RadzenTabsItem Text="Extra barcodes" Icon="qr_code_2">
                <RadzenStack Gap="1rem" class="dialog-section">
                    <RadzenText TextStyle="TextStyle.Subtitle2">Additional barcodes</RadzenText>
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                        <RadzenTextBox @bind-Value="_newBarcode" Placeholder="Scan or type a barcode" Style="flex:1" />
                        <RadzenButton Icon="add" Text="Add" Click="@AddBarcode" Disabled="@string.IsNullOrWhiteSpace(_newBarcode)" />
                    </RadzenStack>

                    @if (Model.AdditionalBarcodes.Count == 0)
                    {
                        <RadzenText TextStyle="TextStyle.Caption" Style="color:var(--sp-text-muted)">No additional barcodes.</RadzenText>
                    }
                    else
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                            @foreach (var bc in Model.AdditionalBarcodes.ToList())
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Base" Style="display:inline-flex;align-items:center;gap:0.35rem">
                                    @bc
                                    <RadzenButton Icon="close" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light"
                                                  Click="@(() => Model.AdditionalBarcodes.Remove(bc))" />
                                </RadzenBadge>
                            }
                        </RadzenStack>
                    }
                </RadzenStack>
            </RadzenTabsItem>

            <RadzenTabsItem Text="Variants" Icon="style">
                <RadzenStack Gap="1rem" class="dialog-section">
                    <RadzenText TextStyle="TextStyle.Caption" Style="color:var(--sp-text-muted)">
                        Optional sellable variants (size, color, pack). Each variant has its own SKU and optional barcode/price.
                    </RadzenText>
                    <RadzenButton Icon="add" Text="Add variant" Size="ButtonSize.Small" Click="@AddVariant" />
                    @if (Model.Variants.Count == 0)
                    {
                        <RadzenText TextStyle="TextStyle.Caption">No variants — base product SKU is used.</RadzenText>
                    }
                    else
                    {
                        <RadzenDataGrid Data="@Model.Variants" TItem="ProductVariantDto" AllowPaging="false">
                            <Columns>
                                <RadzenDataGridColumn TItem="ProductVariantDto" Property="Sku" Title="SKU" Width="130px">
                                    <Template Context="v">
                                        <RadzenTextBox @bind-Value="v.Sku" Style="width:100%" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="ProductVariantDto" Property="Name" Title="Name">
                                    <Template Context="v">
                                        <RadzenTextBox @bind-Value="v.Name" Style="width:100%" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="ProductVariantDto" Property="Barcode" Title="Barcode" Width="130px">
                                    <Template Context="v">
                                        <RadzenTextBox @bind-Value="v.Barcode" Style="width:100%" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="ProductVariantDto" Property="SellPrice" Title="Sell" Width="100px">
                                    <Template Context="v">
                                        <RadzenNumeric @bind-Value="v.SellPrice" Min="0" Format="0.00" Style="width:100%" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="ProductVariantDto" Title="" Width="60px" TextAlign="TextAlign.End">
                                    <Template Context="v">
                                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                                      Click="@(() => Model.Variants.Remove(v))" />
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    }
                </RadzenStack>
            </RadzenTabsItem>


        </Tabs>
    </RadzenTabs>

    @if (_error is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false" Style="margin-top:0.75rem">@_error</RadzenAlert>
    }

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.6rem" Style="margin-top:1rem">
        <RadzenButton ButtonStyle="ButtonStyle.Light" Text="Cancel" Click="@(() => DialogService.Close(false))" />
        <RadzenButton ButtonType="ButtonType.Submit" Icon="save" Text="Save product" IsBusy="@_saving" Disabled="@(_saving || _uploadingImage)" />
    </RadzenStack>
</RadzenTemplateForm>

@code {
    [Parameter] public ProductDto Model { get; set; } = new();
    [Parameter] public IReadOnlyList<LookupDto> Categories { get; set; } = [];
    [Parameter] public IReadOnlyList<LookupDto> Brands { get; set; } = [];
    [Parameter] public IReadOnlyList<LookupDto> Units { get; set; } = [];
    [Parameter] public IReadOnlyList<LookupDto> Taxes { get; set; } = [];

    private string? _newBarcode;
    private bool _saving;
    private bool _uploadingImage;
    private string? _error;

    private int CustomStorePriceCount => Model.StorePrices.Count(price => price.Price.HasValue);

    private void ResetStorePrices()
    {
        foreach (var price in Model.StorePrices)
        {
            price.Price = null;
        }
    }

    private decimal Margin() => Model.SellPrice <= 0 ? 0 : (Model.SellPrice - Model.CostPrice) / Model.SellPrice * 100;

    private void AddVariant() =>
        Model.Variants.Add(new ProductVariantDto { IsActive = true });

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
        {
            return;
        }

        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        if (ext != ".jpg" && ext != ".jpeg" && ext != ".png" && ext != ".webp" && ext != ".gif")
        {
            _error = "Only JPG, PNG, WebP, or GIF images are allowed.";
            return;
        }

        _uploadingImage = true;
        try
        {
            var folder = Path.Combine(Env.WebRootPath, "uploads", "products");
            Directory.CreateDirectory(folder);
            var fileName = $"{Guid.NewGuid():N}{ext}";
            var path = Path.Combine(folder, fileName);
            await using var fs = File.Create(path);
            await using var stream = file.OpenReadStream(5 * 1024 * 1024);
            await stream.CopyToAsync(fs);
            Model.ImageUrl = $"/uploads/products/{fileName}";
        }
        catch
        {
            _error = "Image upload failed.";
        }
        finally
        {
            _uploadingImage = false;
        }
    }

    private void AddBarcode()
    {
        var code = _newBarcode?.Trim();
        if (!string.IsNullOrWhiteSpace(code) && !Model.AdditionalBarcodes.Contains(code, StringComparer.OrdinalIgnoreCase))
        {
            Model.AdditionalBarcodes.Add(code);
        }
        _newBarcode = null;
    }

    private async Task OnSubmit()
    {
        _saving = true;
        _error = null;

        Result result = Model.Id == Guid.Empty
            ? await ProductService.CreateAsync(Model)
            : await ProductService.UpdateAsync(Model);

        _saving = false;
        if (result.Succeeded)
        {
            DialogService.Close(true);
        }
        else
        {
            _error = result.Error;
        }
    }
}
