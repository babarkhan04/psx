@inject IDashboardService DashboardService
@inject NavigationManager Navigation

@implements IDisposable

<div class="command-palette @(Visible ? "open" : "")" @onclick="Close">
    <div class="command-palette-panel" @onclick:stopPropagation="true">
        <div class="command-palette-input">
            <RadzenIcon Icon="search" />
            <input @ref="_input" value="@_query" @oninput="OnInput" @onkeydown="OnKeyDown"
                   placeholder="Search products, pages, categories, brands, stores…" autocomplete="off" />
            <kbd>Esc</kbd>
        </div>

        @if (_loading)
        {
            <div class="command-palette-empty">Searching…</div>
        }
        else if (string.IsNullOrWhiteSpace(_query))
        {
            <div class="command-palette-empty">Type to search products, pages, categories, brands, and stores.</div>
        }
        else if (_results.Count == 0)
        {
            <div class="command-palette-empty">No results for “@_query”.</div>
        }
        else
        {
            <div class="command-palette-results">
                @for (var i = 0; i < _results.Count; i++)
                {
                    var result = _results[i];
                    var index = i;
                    <button type="button" class="command-result @(index == _selectedIndex ? "active" : "")"
                            @onclick="() => NavigateTo(result)">
                        <span class="command-result-icon"><RadzenIcon Icon="@result.Icon" /></span>
                        <span class="command-result-body">
                            <strong>@result.Title</strong>
                            <small>@result.Kind · @result.Subtitle</small>
                        </span>
                        <RadzenIcon Icon="north_west" Style="font-size:0.9rem;color:var(--sp-text-muted)" />
                    </button>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    private ElementReference _input;
    private string _query = string.Empty;
    private IReadOnlyList<GlobalSearchResultDto> _results = [];
    private bool _loading;
    private int _selectedIndex;
    private CancellationTokenSource? _debounceCts;
    private bool _disposed;

    protected override async Task OnParametersSetAsync()
    {
        if (Visible)
        {
            _query = string.Empty;
            _results = [];
            _selectedIndex = 0;
            await Task.Yield();
            try { await _input.FocusAsync(); } catch { /* focus may fail on first render */ }
        }
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? string.Empty;
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        if (string.IsNullOrWhiteSpace(_query))
        {
            _results = [];
            _loading = false;
            return;
        }

        try
        {
            _loading = true;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(180, token);
            _selectedIndex = 0;
            _results = await DashboardService.SearchAsync(_query, take: 12, token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (ObjectDisposedException)
        {
            // Search continued while the layout/circuit was being disposed.
            return;
        }
        catch (InvalidOperationException ex) when (ex.Message.Contains("disposed", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }
        finally
        {
            if (!_disposed && !token.IsCancellationRequested)
            {
                _loading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await Close();
            return;
        }

        if (_results.Count == 0)
        {
            return;
        }

        if (e.Key == "ArrowDown")
        {
            _selectedIndex = Math.Min(_selectedIndex + 1, _results.Count - 1);
        }
        else if (e.Key == "ArrowUp")
        {
            _selectedIndex = Math.Max(_selectedIndex - 1, 0);
        }
        else if (e.Key == "Enter")
        {
            NavigateTo(_results[_selectedIndex]);
        }
    }

    private void NavigateTo(GlobalSearchResultDto result)
    {
        Navigation.NavigateTo(result.Path);
        _ = Close();
    }

    private async Task Close()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
    }

    public void Dispose()
    {
        _disposed = true;
        try
        {
            _debounceCts?.Cancel();
            _debounceCts?.Dispose();
        }
        catch
        {
            // no-op: circuit may already be gone
        }
    }
}
