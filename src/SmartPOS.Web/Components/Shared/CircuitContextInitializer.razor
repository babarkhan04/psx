@using Microsoft.AspNetCore.Components.Authorization
@using SmartPOS.Application.Common.Interfaces
@inject AuthenticationStateProvider AuthStateProvider
@inject IUserContextAccessor UserContext

@if (_ready)
{
    @ChildContent
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        // Inside a Blazor Server circuit there is no live HttpContext, so we
        // prime the scoped principal accessor from the authentication state.
        // Tenant isolation, auditing, and permission checks all read from here.
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            UserContext.SetPrincipal(state.User);
        }

        _ready = true;
    }
}
