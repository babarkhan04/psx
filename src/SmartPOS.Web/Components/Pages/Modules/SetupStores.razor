@page "/setup/stores"
@attribute [Authorize(Policy = Permissions.Setup.StoresView)]
@inject IStoreService StoreService
@inject DialogService DialogService
@inject NotificationService Notifications

<PageTitle>Stores · SmartPOS</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Stores &amp; Branches</h1>
        <p class="page-subtitle">Manage the store locations that operate under your company.</p>
    </div>
    <div class="toolbar-actions">
        <RadzenButton Icon="add" Text="New store" Click="@(() => OpenEditor(null))"
                      Disabled="@(!_canManage)" />
    </div>
</div>

<RadzenCard class="content-card grid-card">
    <RadzenDataGrid @ref="_grid" Data="@_stores" TItem="StoreDto" AllowFiltering="true"
                    AllowSorting="true" AllowPaging="true" PageSize="10" FilterMode="FilterMode.Simple"
                    EmptyText="No stores yet." IsLoading="@_loading">
        <Columns>
            <RadzenDataGridColumn TItem="StoreDto" Property="Code" Title="Code" Width="110px" />
            <RadzenDataGridColumn TItem="StoreDto" Property="Name" Title="Name" />
            <RadzenDataGridColumn TItem="StoreDto" Property="City" Title="City" />
            <RadzenDataGridColumn TItem="StoreDto" Property="Phone" Title="Phone" Sortable="false" />
            <RadzenDataGridColumn TItem="StoreDto" Property="IsActive" Title="Status" Width="120px" TextAlign="TextAlign.Center">
                <Template Context="store">
                    <span class="status-pill @(store.IsActive ? "on" : "off")">
                        @(store.IsActive ? "Active" : "Inactive")
                    </span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="StoreDto" Title="" Width="140px" Sortable="false" Filterable="false" TextAlign="TextAlign.End">
                <Template Context="store">
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                  Click="@(() => OpenEditor(store))" Disabled="@(!_canManage)" />
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                  Click="@(() => DeleteAsync(store))" Disabled="@(!_canManage)" Style="margin-left:0.35rem" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</RadzenCard>

@code {
    private RadzenDataGrid<StoreDto>? _grid;
    private IReadOnlyList<StoreDto> _stores = [];
    private bool _loading = true;
    private bool _canManage;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            _canManage = state.User.HasClaim(Permissions.ClaimType, Permissions.Setup.StoresManage);
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _stores = await StoreService.GetAllAsync();
        _loading = false;
    }

    private async Task OpenEditor(StoreDto? store)
    {
        if (!_canManage)
        {
            return;
        }

        var model = store is null
            ? new StoreDto()
            : new StoreDto
            {
                Id = store.Id, Code = store.Code, Name = store.Name,
                AddressLine1 = store.AddressLine1, AddressLine2 = store.AddressLine2,
                City = store.City, Region = store.Region, PostalCode = store.PostalCode,
                Country = store.Country, Phone = store.Phone, Email = store.Email,
                TimeZoneId = store.TimeZoneId, IsActive = store.IsActive
            };

        var saved = await DialogService.OpenAsync<StoreDialog>(
            store is null ? "New store" : $"Edit · {store.Name}",
            new Dictionary<string, object> { [nameof(StoreDialog.Model)] = model },
            new DialogOptions { Width = "760px", CloseDialogOnOverlayClick = false });

        if (saved is true)
        {
            await LoadAsync();
            Notify("Saved", "Store saved successfully.", NotificationSeverity.Success);
        }
    }

    private async Task DeleteAsync(StoreDto store)
    {
        var confirmed = await DialogService.Confirm(
            $"Delete store '{store.Name}'? This cannot be undone.", "Delete store",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed != true)
        {
            return;
        }

        var result = await StoreService.DeleteAsync(store.Id);
        if (result.Succeeded)
        {
            await LoadAsync();
            Notify("Deleted", "Store removed.", NotificationSeverity.Success);
        }
        else
        {
            Notify("Could not delete", result.Error ?? "Unknown error", NotificationSeverity.Error);
        }
    }

    private void Notify(string summary, string detail, NotificationSeverity severity) =>
        Notifications.Notify(new NotificationMessage { Severity = severity, Summary = summary, Detail = detail, Duration = 4000 });
}
