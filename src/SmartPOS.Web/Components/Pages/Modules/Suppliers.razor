@page "/suppliers"
@attribute [Authorize(Policy = Permissions.Relationships.SuppliersView)]
@inject ISupplierService SupplierService
@inject DialogService DialogService
@inject NotificationService Notifications

<PageTitle>Suppliers · SmartPOS</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Suppliers</h1>
        <p class="page-subtitle">Vendor profiles for purchase orders and goods receiving.</p>
    </div>
    <div class="toolbar-actions">
        <RadzenTextBox @bind-Value="_search" Placeholder="Search name, phone, city…" Style="min-width:240px"
                       @oninput="@(args => _search = args.Value?.ToString())" Change="@LoadAsync" />
        <RadzenButton Icon="search" ButtonStyle="ButtonStyle.Light" Click="@LoadAsync" />
        @if (_canManage)
        {
            <RadzenButton Icon="add" Text="New supplier" Click="@(() => OpenEditor(null))" />
        }
    </div>
</div>

<RadzenCard class="content-card grid-card">
    <RadzenDataGrid Data="@_suppliers" TItem="SupplierListItemDto" AllowSorting="true" AllowPaging="true"
                    PageSize="12" EmptyText="No suppliers found." IsLoading="@_loading">
        <Columns>
            <RadzenDataGridColumn TItem="SupplierListItemDto" Property="Name" Title="Supplier" />
            <RadzenDataGridColumn TItem="SupplierListItemDto" Property="Phone" Title="Phone" Width="150px" />
            <RadzenDataGridColumn TItem="SupplierListItemDto" Property="City" Title="City" Width="130px" />
            <RadzenDataGridColumn TItem="SupplierListItemDto" Property="TaxNumber" Title="NTN / Tax" Width="130px" />
            <RadzenDataGridColumn TItem="SupplierListItemDto" Property="PurchaseCount" Title="GRNs" Width="90px" TextAlign="TextAlign.Center" />
            <RadzenDataGridColumn TItem="SupplierListItemDto" Property="IsActive" Title="Status" Width="100px" TextAlign="TextAlign.Center">
                <Template Context="s">
                    <span class="status-pill @(s.IsActive ? "on" : "off")">@(s.IsActive ? "Active" : "Inactive")</span>
                </Template>
            </RadzenDataGridColumn>
            @if (_canManage)
            {
                <RadzenDataGridColumn TItem="SupplierListItemDto" Title="" Width="120px" Sortable="false" TextAlign="TextAlign.End">
                    <Template Context="s">
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => OpenEditor(s))" />
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                      Click="@(() => DeleteAsync(s))" Style="margin-left:0.35rem" />
                    </Template>
                </RadzenDataGridColumn>
            }
        </Columns>
    </RadzenDataGrid>
</RadzenCard>

@code {
    private IReadOnlyList<SupplierListItemDto> _suppliers = [];
    private string? _search;
    private bool _loading = true;
    private bool _canManage;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            _canManage = state.User.HasClaim(Permissions.ClaimType, Permissions.Relationships.SuppliersManage);
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        _suppliers = await SupplierService.GetAllAsync(_search);
        _loading = false;
    }

    private async Task OpenEditor(SupplierListItemDto? item)
    {
        var model = item is null
            ? new SupplierDto { IsActive = true }
            : await SupplierService.GetAsync(item.Id) ?? new SupplierDto { IsActive = true };

        var saved = await DialogService.OpenAsync<SupplierDialog>(
            item is null ? "New supplier" : $"Edit · {item.Name}",
            new Dictionary<string, object?> { [nameof(SupplierDialog.Model)] = model },
            new DialogOptions { Width = "600px", CloseDialogOnOverlayClick = false });

        if (saved is true)
        {
            await LoadAsync();
            Notify("Saved", "Supplier saved.", NotificationSeverity.Success);
        }
    }

    private async Task DeleteAsync(SupplierListItemDto s)
    {
        if (await DialogService.Confirm($"Delete supplier '{s.Name}'?", "Delete", new ConfirmOptions { OkButtonText = "Delete" }) != true)
        {
            return;
        }

        var result = await SupplierService.DeleteAsync(s.Id);
        if (result.Succeeded)
        {
            await LoadAsync();
            Notify("Deleted", "Supplier removed.", NotificationSeverity.Success);
        }
        else
        {
            Notify("Could not delete", result.Error ?? "Unknown error", NotificationSeverity.Error);
        }
    }

    private void Notify(string summary, string detail, NotificationSeverity severity) =>
        Notifications.Notify(new NotificationMessage { Severity = severity, Summary = summary, Detail = detail, Duration = 4000 });
}
