@page "/setup/company"
@attribute [Authorize(Policy = Permissions.Setup.CompanyView)]
@inject ICompanyService CompanyService
@inject NotificationService Notifications

<PageTitle>Company · SmartPOS</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Company Profile</h1>
        <p class="page-subtitle">Legal identity and contact details used across documents and receipts.</p>
    </div>
</div>

@if (_model is null)
{
    <RadzenCard class="content-card">
        <RadzenText>Loading…</RadzenText>
    </RadzenCard>
}
else
{
    <RadzenCard class="content-card" Style="max-width:820px">
        <RadzenTemplateForm TItem="CompanyDto" Data="@_model" Submit="@OnSubmit">
            <DataAnnotationsValidator />
            <RadzenStack Gap="1.25rem">
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Company name" Variant="Variant.Outlined" Style="width:100%">
                            <RadzenTextBox @bind-Value="_model.Name" Name="Name" />
                        </RadzenFormField>
                        <RadzenRequiredValidator Component="Name" Text="Company name is required" Popup="true" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Legal name" Variant="Variant.Outlined" Style="width:100%">
                            <RadzenTextBox @bind-Value="_model.LegalName" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Email" Variant="Variant.Outlined" Style="width:100%">
                            <RadzenTextBox @bind-Value="_model.Email" Name="Email" />
                        </RadzenFormField>
                        <RadzenEmailValidator Component="Email" Text="Enter a valid email" Popup="true" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Phone" Variant="Variant.Outlined" Style="width:100%">
                            <RadzenTextBox @bind-Value="_model.Phone" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Tax / registration number" Variant="Variant.Outlined" Style="width:100%">
                            <RadzenTextBox @bind-Value="_model.TaxNumber" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Logo URL" Variant="Variant.Outlined" Style="width:100%">
                            <RadzenTextBox @bind-Value="_model.LogoUrl" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenCheckBox @bind-Value="_model.IsActive" Name="IsActive" />
                <RadzenLabel Text="Company is active" Component="IsActive" />

                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem">
                    <RadzenButton ButtonType="ButtonType.Submit" Icon="save" Text="Save changes"
                                  Disabled="@(!_canManage || _saving)" IsBusy="@_saving" />
                </RadzenStack>
            </RadzenStack>
        </RadzenTemplateForm>
    </RadzenCard>
}

@code {
    private CompanyDto? _model;
    private bool _saving;
    private bool _canManage;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            _canManage = state.User.HasClaim(Permissions.ClaimType, Permissions.Setup.CompanyManage);
        }

        _model = await CompanyService.GetAsync() ?? new CompanyDto();
    }

    private async Task OnSubmit()
    {
        if (!_canManage || _model is null)
        {
            return;
        }

        _saving = true;
        var result = await CompanyService.UpdateAsync(_model);
        _saving = false;

        Notifications.Notify(new NotificationMessage
        {
            Severity = result.Succeeded ? NotificationSeverity.Success : NotificationSeverity.Error,
            Summary = result.Succeeded ? "Saved" : "Could not save",
            Detail = result.Succeeded ? "Company profile updated." : result.Error,
            Duration = 4000
        });
    }
}
