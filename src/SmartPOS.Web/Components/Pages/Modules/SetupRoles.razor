@page "/setup/roles"
@attribute [Authorize(Policy = Permissions.Setup.RolesView)]
@inject IRoleAdminService RoleService
@inject DialogService DialogService
@inject NotificationService Notifications

<PageTitle>Roles · SmartPOS</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Roles &amp; Permissions</h1>
        <p class="page-subtitle">Define what each role can see and do across the system.</p>
    </div>
    <div class="toolbar-actions">
        <RadzenButton Icon="add" Text="New role" Click="@CreateRoleAsync" Disabled="@(!_canManage)" />
    </div>
</div>

<RadzenCard class="content-card grid-card">
    <RadzenDataGrid Data="@_roles" TItem="RoleDto" AllowSorting="true" EmptyText="No roles." IsLoading="@_loading">
        <Columns>
            <RadzenDataGridColumn TItem="RoleDto" Property="Name" Title="Role" />
            <RadzenDataGridColumn TItem="RoleDto" Title="Type" Width="120px">
                <Template Context="role">
                    <span class="status-pill @(role.IsBuiltIn ? "off" : "on")">@(role.IsBuiltIn ? "Built-in" : "Custom")</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="RoleDto" Property="UserCount" Title="Users" Width="90px" TextAlign="TextAlign.Center" />
            <RadzenDataGridColumn TItem="RoleDto" Property="Permissions.Count" Title="Permissions" Width="120px" TextAlign="TextAlign.Center">
                <Template Context="role">@role.Permissions.Count</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="RoleDto" Title="" Width="220px" Sortable="false" TextAlign="TextAlign.End">
                <Template Context="role">
                    <RadzenButton Icon="tune" Text="Permissions" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                  Click="@(() => EditPermissionsAsync(role))" />
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                  Click="@(() => DeleteAsync(role))" Disabled="@(!_canManage || role.IsBuiltIn)"
                                  Style="margin-left:0.35rem" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</RadzenCard>

@code {
    private IReadOnlyList<RoleDto> _roles = [];
    private bool _loading = true;
    private bool _canManage;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            _canManage = state.User.HasClaim(Permissions.ClaimType, Permissions.Setup.RolesManage);
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _roles = await RoleService.GetAllAsync();
        _loading = false;
    }

    private async Task CreateRoleAsync()
    {
        var name = await DialogService.OpenAsync<RoleNameDialog>("New role",
            new Dictionary<string, object>(),
            new DialogOptions { Width = "420px", CloseDialogOnOverlayClick = false });

        if (name is string roleName && !string.IsNullOrWhiteSpace(roleName))
        {
            var result = await RoleService.CreateAsync(roleName);
            if (result.Succeeded)
            {
                await LoadAsync();
                Notify("Created", "Role created.", NotificationSeverity.Success);
            }
            else
            {
                Notify("Could not create", result.Error ?? "Unknown error", NotificationSeverity.Error);
            }
        }
    }

    private async Task EditPermissionsAsync(RoleDto role)
    {
        var saved = await DialogService.OpenAsync<RolePermissionsDialog>(
            $"Permissions · {role.Name}",
            new Dictionary<string, object>
            {
                [nameof(RolePermissionsDialog.RoleId)] = role.Id,
                [nameof(RolePermissionsDialog.CanManage)] = _canManage
            },
            new DialogOptions { Width = "900px", CloseDialogOnOverlayClick = false });

        if (saved is true)
        {
            await LoadAsync();
            Notify("Saved", "Permissions updated. Affected users may need to sign in again.", NotificationSeverity.Success);
        }
    }

    private async Task DeleteAsync(RoleDto role)
    {
        var confirmed = await DialogService.Confirm(
            $"Delete role '{role.Name}'?", "Delete role",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed != true)
        {
            return;
        }

        var result = await RoleService.DeleteAsync(role.Id);
        if (result.Succeeded)
        {
            await LoadAsync();
            Notify("Deleted", "Role removed.", NotificationSeverity.Success);
        }
        else
        {
            Notify("Could not delete", result.Error ?? "Unknown error", NotificationSeverity.Error);
        }
    }

    private void Notify(string summary, string detail, NotificationSeverity severity) =>
        Notifications.Notify(new NotificationMessage { Severity = severity, Summary = summary, Detail = detail, Duration = 4500 });
}
