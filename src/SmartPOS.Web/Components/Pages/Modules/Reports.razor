@page "/reports"
@attribute [Authorize(Policy = Permissions.Insights.ReportsView)]
@inject IReportService ReportService
@inject IStoreService StoreService
@inject IStoreContext StoreContext
@inject DialogService DialogService
@inject ILogger<Reports> Logger

<PageTitle>Reports &amp; Analytics · SmartPOS</PageTitle>

<div class="reports-workspace">
    <header class="reports-hero">
        <div><span class="reports-eyebrow">SMARTPOS INSIGHTS</span><h1>Reports &amp; Analytics</h1><p>Your business, in focus. Explore the numbers behind every sale.</p></div>
        <div class="reports-hero-actions">
            <span class="reports-live"><span></span>@Definitions.Count reports</span>
            <a href="@(_report is null || _loading ? null : ExportUrl)" aria-disabled="@(_report is null || _loading)" class="reports-export"><RadzenIcon Icon="download" /> Export workbook</a>
        </div>
    </header>

    <section class="reports-filters" aria-label="Report filters">
        <div class="reports-filter-fields">
            <RadzenFormField Text="Store" Variant="Variant.Outlined" Style="width:100%">
                <RadzenDropDown @bind-Value="_storeId" Data="@_storeOptions" Placeholder="All accessible stores" TextProperty="Text" ValueProperty="Value" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Disabled="@_loading" Style="width:100%" />
            </RadzenFormField>
            <RadzenFormField Text="From (UTC)" Variant="Variant.Outlined" Style="width:100%">
                <RadzenDatePicker @bind-Value="_from" DateFormat="dd MMM yyyy" ShowTime="false" Disabled="@_loading" Style="width:100%" />
            </RadzenFormField>
            <RadzenFormField Text="To (UTC, inclusive)" Variant="Variant.Outlined" Style="width:100%">
                <RadzenDatePicker @bind-Value="_to" DateFormat="dd MMM yyyy" ShowTime="false" Disabled="@_loading" Style="width:100%" />
            </RadzenFormField>
            <RadzenButton Icon="tune" Text="Apply filters" Click="@LoadAsync" IsBusy="@_loading" Disabled="@_loading" />
        </div>
        <div class="reports-filter-footer">
            <div class="reports-presets" aria-label="Date shortcuts">
                @foreach (var preset in new[] { (0, "Today"), (6, "7 days"), (29, "30 days"), (-1, "This month"), (-2, "Last month") })
                {
                    <button type="button" disabled="@_loading" class="@(IsPreset(preset.Item1) ? "active" : "")" @onclick="@(() => SetPresetAsync(preset.Item1))">@preset.Item2</button>
                }
            </div>
            <span class="reports-filter-note">@(HasPendingChanges ? "Filters changed — apply to update reports and export." : "Transaction dates and times use UTC. Stock figures are current.")</span>
        </div>
    </section>

    @if (_error is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false">@_error</RadzenAlert>
    }

    <div class="reports-layout">
        <aside class="reports-sidebar" aria-label="Report navigation">
            <div class="reports-mobile-select">
                <RadzenFormField Text="Choose a report" Variant="Variant.Outlined" Style="width:100%">
                    <RadzenDropDown @bind-Value="_selectedId" Data="@Definitions" TextProperty="Title" ValueProperty="Id" Name="ReportSelector"
                                    AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Style="width:100%" />
                </RadzenFormField>
            </div>
            <div class="reports-search"><RadzenIcon Icon="search" /><input aria-label="Find a report" placeholder="Find a report…" @bind="_navigationSearch" @bind:event="oninput" /></div>
            <nav>
                @foreach (var group in VisibleDefinitions.GroupBy(item => item.Group))
                {
                    <div class="reports-nav-group"><span>@group.Key</span>
                        @foreach (var item in group)
                        {
                            <button type="button" class="@(_selectedId == item.Id ? "selected" : "")" aria-current="@(_selectedId == item.Id ? "page" : null)" @onclick="@(() => SelectReport(item.Id))"><RadzenIcon Icon="@item.Icon" /><span>@item.Title</span>@if (NewReportIds.Contains(item.Id)) { <small>NEW</small> }</button>
                        }
                    </div>
                }
                @if (!VisibleDefinitions.Any()) { <p class="reports-no-match">No matching reports.</p> }
            </nav>
        </aside>
        <section class="reports-main" aria-busy="@_loading" aria-label="Report results">
            <div class="reports-section-heading"><div><span class="reports-section-kicker">@ActiveDefinition.Group</span><h2>@ActiveDefinition.Title</h2><p>@ActiveDefinition.Description</p></div></div>
            @if (_appliedQuery is not null)
            {
                <div class="reports-context"><span><RadzenIcon Icon="storefront" />@AppliedStoreName</span><span><RadzenIcon Icon="calendar_today" />@PeriodLabel</span><span class="reports-updated">Updated @_loadedAt.ToString("HH:mm") UTC</span></div>
            }
            @if (_loading) { <div class="reports-loading" role="status"><RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" /><span>Updating reports…</span></div> }
            @if (_report is not null)
            {
                @if (_selectedId == "overview")
                {
                    <div class="reports-metrics">
                        <article class="report-metric metric-primary"><span>Net sales <RadzenIcon Icon="payments" /></span><strong>@Money(_report.SalesSummary.NetSales)</strong><small>@_report.SalesSummary.TransactionCount.ToString("N0") transactions · after refunds</small></article>
                        <article class="report-metric"><span>Gross profit <RadzenIcon Icon="trending_up" /></span><strong>@Money(_report.SalesSummary.GrossProfit)</strong><small>@Pct(_report.SalesSummary.MarginPercent) margin · before operating expenses</small></article>
                        <article class="report-metric"><span>Average basket <RadzenIcon Icon="shopping_basket" /></span><strong>@Money(_report.SalesSummary.AverageBasket)</strong><small>@Money(_report.SalesSummary.DiscountTotal) discounts</small></article>
                        <article class="report-metric"><span>Stock value now <RadzenIcon Icon="inventory_2" /></span><strong>@Money(_report.CurrentStock.Sum(row => row.StockValue))</strong><small>@_report.CurrentStock.Count.ToString("N0") stock lines · at current cost</small></article>
                    </div>
                    <div class="reports-charts">
                        <section class="report-panel"><div class="report-panel-heading"><div><h3>Sales &amp; profit</h3><p>@TrendCaption</p></div><button type="button" class="report-text-action" @onclick="@(() => SelectReport("daily"))">View report <RadzenIcon Icon="arrow_forward" /></button></div>
                            @if (_report.DailySales.Count > 0)
                            {
                                <RadzenChart Style="height:285px">
                                    <RadzenLineSeries Data="@_trend" CategoryProperty="Date" ValueProperty="Sales" Title="Net sales" Stroke="#4f46e5"><RadzenMarkers Visible="@(_trend.Count == 1)" MarkerType="MarkerType.Circle" Size="6" /></RadzenLineSeries>
                                    <RadzenLineSeries Data="@_trend" CategoryProperty="Date" ValueProperty="Profit" Title="Gross profit" Stroke="#10b981"><RadzenMarkers Visible="@(_trend.Count == 1)" MarkerType="MarkerType.Circle" Size="6" /></RadzenLineSeries>
                                    <RadzenCategoryAxis Padding="15" FormatString="{0:dd MMM}" TickDistance="85" LabelAutoRotation="-45" />
                                    <RadzenValueAxis Formatter="@ChartMoney" />
                                    <RadzenLegend Position="LegendPosition.Bottom" />
                                </RadzenChart>
                            }
                            else { <div class="report-chart-empty"><RadzenIcon Icon="show_chart" /><strong>No sales activity in this period</strong><span>Try another date range or store.</span></div> }
                        </section>
                        <section class="report-panel"><div class="report-panel-heading"><div><h3>Payment mix</h3><p>Receipts before refunds</p></div></div>
                            @if (_report.PaymentMix.Any(row => row.Amount > 0))
                            {
                                <RadzenChart Style="height:285px"><RadzenDonutSeries Data="@_report.PaymentMix" CategoryProperty="Method" ValueProperty="Amount" /><RadzenLegend Position="LegendPosition.Bottom" /></RadzenChart>
                            }
                            else { <div class="report-chart-empty"><RadzenIcon Icon="account_balance_wallet" /><strong>No payment receipts</strong><span>Receipts will appear as sales are completed.</span></div> }
                        </section>
                    </div>
                    <div class="reports-highlights">
                        <section class="report-panel"><div class="report-panel-heading"><div><h3>Best-selling products</h3><p>Ranked by revenue after refunds</p></div><button type="button" class="report-text-action" @onclick="@(() => SelectReport("products"))">View all</button></div>
                            @if (_report.ProductPerformance.Count == 0) { <p class="report-empty-inline">No product sales in this period.</p> }
                            @foreach (var product in _report.ProductPerformance.Take(5))
                            {
                                <div class="report-ranking"><span class="report-ranking-icon"><RadzenIcon Icon="inventory_2" /></span><div><strong>@product.ProductName</strong><small>@product.Sku · @Qty(product.NetQuantity) net units</small></div><b>@Money(product.Revenue)</b></div>
                            }
                        </section>
                        <section class="report-panel"><div class="report-panel-heading"><div><h3>Keep an eye on</h3><p>Useful signals for your next decision</p></div></div>
                            <button type="button" class="report-attention" @onclick="@(() => SelectReport("low-stock"))"><span class="attention-icon amber"><RadzenIcon Icon="warning_amber" /></span><span><strong>Low &amp; out-of-stock</strong><small>Current stock lines needing review</small></span><b>@_report.CurrentStock.Count(row => row.IsLowStock || row.IsOutOfStock)</b><RadzenIcon Icon="chevron_right" /></button>
                            <button type="button" class="report-attention" @onclick="@(() => SelectReport("slow-stock"))"><span class="attention-icon violet"><RadzenIcon Icon="hourglass_empty" /></span><span><strong>Slow-moving stock</strong><small>On hand now, five or fewer units sold in this period</small></span><b>@_report.SlowMovingStock.Count</b><RadzenIcon Icon="chevron_right" /></button>
                            <button type="button" class="report-attention" @onclick="@(() => SelectReport("returns"))"><span class="attention-icon rose"><RadzenIcon Icon="assignment_return" /></span><span><strong>Returns &amp; refunds</strong><small>@_report.SalesSummary.ReturnCount refunds in this period</small></span><b>@Money(_report.SalesSummary.ReturnsTotal)</b><RadzenIcon Icon="chevron_right" /></button>
                            <div class="report-secondary-totals"><span>Tax collected <strong>@Money(_report.SalesSummary.TaxCollected)</strong></span><span>Received purchases <strong>@Money(_report.Purchases.TotalPurchased)</strong></span></div>
                        </section>
                    </div>
                }
                else
                {
                    @if (_selectedId == "tax")
                    {
                        <div class="reports-metrics">
                            <article class="report-metric"><span>Taxable sales</span><strong>@Money(_report.Tax.TaxableSales)</strong><small>Sales in the selected period</small></article>
                            <article class="report-metric"><span>Tax collected</span><strong>@Money(_report.Tax.GstCollected)</strong><small>After refunds recorded in the period</small></article>
                            <article class="report-metric"><span>Exempt sales</span><strong>@Money(_report.Tax.ExemptSales)</strong><small>Sales with no tax</small></article>
                            <article class="report-metric"><span>Purchase tax</span><strong>@Money(_report.Purchases.TotalTax)</strong><small>Received purchases in the period</small></article>
                        </div>
                    }
                    @if (_selectedId is "purchases" or "suppliers")
                    {
                        <div class="reports-metrics">
                            <article class="report-metric"><span>Received purchases</span><strong>@_report.Purchases.PurchaseCount.ToString("N0")</strong><small>By receipt date</small></article>
                            <article class="report-metric"><span>Purchase total</span><strong>@Money(_report.Purchases.TotalPurchased)</strong><small>Including purchase tax</small></article>
                            <article class="report-metric"><span>Purchase tax</span><strong>@Money(_report.Purchases.TotalTax)</strong><small>Received purchases only</small></article>
                        </div>
                    }
                    <section class="report-panel report-table" @key="_selectedId">
                        <div class="report-panel-heading"><div><h3>@ActiveDefinition.Title</h3><p>@ActiveRowCount.ToString("N0") rows · sort or filter columns to explore</p></div><span class="report-table-badge">@(IsSnapshot ? "Current snapshot" : "Selected period")</span></div>
                        @switch (_selectedId)
                        {
                            case "daily":
<RadzenDataGrid AllowPaging="true" PageSize="20" AllowSorting="true" AllowFiltering="true" AllowColumnResize="true" ShowPagingSummary="true" EmptyText="No records match these filters." Data="@_report.DailySales" TItem="DailySalesRowDto">
                        <Columns>
                            <RadzenDataGridColumn TItem="DailySalesRowDto" Property="Date" Title="Date" Width="135px">
                                <Template Context="d">@d.Date.ToString("dd MMM yyyy")</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DailySalesRowDto" Property="Transactions" Title="Txns" Width="80px" TextAlign="TextAlign.Center" />
                            <RadzenDataGridColumn TItem="DailySalesRowDto" Property="GrossSales" Title="Gross" TextAlign="TextAlign.End"><Template Context="d">@Money(d.GrossSales)</Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DailySalesRowDto" Property="Discounts" Title="Discounts" TextAlign="TextAlign.End"><Template Context="d">@Money(d.Discounts)</Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DailySalesRowDto" Property="Returns" Title="Returns" TextAlign="TextAlign.End"><Template Context="d">@Money(d.Returns)</Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DailySalesRowDto" Property="NetSales" Title="Net" TextAlign="TextAlign.End"><Template Context="d"><strong>@Money(d.NetSales)</strong></Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DailySalesRowDto" Property="GrossProfit" Title="Profit" TextAlign="TextAlign.End"><Template Context="d"><span class="@(d.GrossProfit >= 0 ? "text-ok" : "text-warn")">@Money(d.GrossProfit)</span></Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DailySalesRowDto" Property="MarginPercent" Title="Margin" Width="90px" TextAlign="TextAlign.End"><Template Context="d">@Pct(d.MarginPercent)</Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DailySalesRowDto" Property="VoidCount" Title="Voids" Width="80px" TextAlign="TextAlign.Center" />
                        </Columns>
                    </RadzenDataGrid>
                                break;
                            case "invoices":
<RadzenDataGrid Data="@_report.SalesRegister" TItem="SalesRegisterRowDto" AllowPaging="true" PageSize="20" AllowSorting="true" AllowFiltering="true" AllowColumnResize="true" ShowPagingSummary="true" EmptyText="No records match these filters.">
<Columns>
<RadzenDataGridColumn TItem="SalesRegisterRowDto" Property="CompletedOn" Title="Completed (UTC)" Width="170px"><Template Context="row">@row.CompletedOn.ToString("dd MMM yyyy HH:mm")</Template></RadzenDataGridColumn>
<RadzenDataGridColumn TItem="SalesRegisterRowDto" Property="SaleNumber" Title="Invoice" Width="170px" />
<RadzenDataGridColumn TItem="SalesRegisterRowDto" Property="StoreName" Title="Store" Width="170px" />
<RadzenDataGridColumn TItem="SalesRegisterRowDto" Property="CashierName" Title="Cashier" Width="170px" />
<RadzenDataGridColumn TItem="SalesRegisterRowDto" Property="CustomerName" Title="Customer" Width="170px" />
<RadzenDataGridColumn TItem="SalesRegisterRowDto" Property="Status" Title="Status" Width="170px"><Template Context="row"><span class="report-status">@row.Status</span></Template></RadzenDataGridColumn>
<RadzenDataGridColumn TItem="SalesRegisterRowDto" Property="PaymentMethods" Title="Payment" Width="170px" />
<RadzenDataGridColumn TItem="SalesRegisterRowDto" Property="TotalAmount" Title="Invoice total" Width="170px" TextAlign="TextAlign.End"><Template Context="row">@Money(row.TotalAmount)</Template></RadzenDataGridColumn>
<RadzenDataGridColumn TItem="SalesRegisterRowDto" Property="Discounts" Title="Discounts" Width="170px" TextAlign="TextAlign.End"><Template Context="row">@Money(row.Discounts)</Template></RadzenDataGridColumn>
<RadzenDataGridColumn TItem="SalesRegisterRowDto" Property="Tax" Title="Tax" Width="170px" TextAlign="TextAlign.End"><Template Context="row">@Money(row.Tax)</Template></RadzenDataGridColumn>
<RadzenDataGridColumn TItem="SalesRegisterRowDto" Property="RefundsInPeriod" Title="Refunds in period" Width="170px" TextAlign="TextAlign.End"><Template Context="row">@Money(row.RefundsInPeriod)</Template></RadzenDataGridColumn>
<RadzenDataGridColumn TItem="SalesRegisterRowDto" Property="NetSales" Title="Net sales" Width="170px" TextAlign="TextAlign.End"><Template Context="row">@Money(row.NetSales)</Template></RadzenDataGridColumn>
</Columns>
</RadzenDataGrid>
                                break;
                            case "stores":
<RadzenDataGrid AllowPaging="true" PageSize="20" AllowSorting="true" AllowFiltering="true" AllowColumnResize="true" ShowPagingSummary="true" EmptyText="No records match these filters." Data="@_report.SalesByStore" TItem="StoreSalesRowDto">
                        <Columns>
                            <RadzenDataGridColumn TItem="StoreSalesRowDto" Property="StoreName" Title="Store" />
                            <RadzenDataGridColumn TItem="StoreSalesRowDto" Property="Transactions" Title="Txns" Width="90px" TextAlign="TextAlign.Center" />
                            <RadzenDataGridColumn TItem="StoreSalesRowDto" Property="GrossSales" Title="Gross" TextAlign="TextAlign.End"><Template Context="s">@Money(s.GrossSales)</Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="StoreSalesRowDto" Property="Returns" Title="Returns" TextAlign="TextAlign.End"><Template Context="s">@Money(s.Returns)</Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="StoreSalesRowDto" Property="NetSales" Title="Net" TextAlign="TextAlign.End"><Template Context="s"><strong>@Money(s.NetSales)</strong></Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="StoreSalesRowDto" Property="GrossProfit" Title="Profit" TextAlign="TextAlign.End"><Template Context="s">@Money(s.GrossProfit)</Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="StoreSalesRowDto" Property="MarginPercent" Title="Margin" Width="90px" TextAlign="TextAlign.End"><Template Context="s">@Pct(s.MarginPercent)</Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="StoreSalesRowDto" Title="" Width="75px" Sortable="false" TextAlign="TextAlign.Center">
                                <Template Context="s"><RadzenButton Icon="insights" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => ShowStoreInsightAsync(s))" /></Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                                break;
                            case "cashiers":
<RadzenDataGrid AllowPaging="true" PageSize="20" AllowSorting="true" AllowFiltering="true" AllowColumnResize="true" ShowPagingSummary="true" EmptyText="No records match these filters." Data="@_report.SalesByCashier" TItem="CashierSalesRowDto">
                        <Columns>
                            <RadzenDataGridColumn TItem="CashierSalesRowDto" Property="CashierName" Title="Cashier" />
                            <RadzenDataGridColumn TItem="CashierSalesRowDto" Property="Transactions" Title="Txns" Width="80px" TextAlign="TextAlign.Center" />
                            <RadzenDataGridColumn TItem="CashierSalesRowDto" Property="VoidCount" Title="Voids" Width="80px" TextAlign="TextAlign.Center" />
                            <RadzenDataGridColumn TItem="CashierSalesRowDto" Property="ReturnCount" Title="Returns" Width="90px" TextAlign="TextAlign.Center" />
                            <RadzenDataGridColumn TItem="CashierSalesRowDto" Property="Discounts" Title="Discounts" TextAlign="TextAlign.End"><Template Context="c">@Money(c.Discounts)</Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="CashierSalesRowDto" Property="NetSales" Title="Net sales" TextAlign="TextAlign.End"><Template Context="c"><strong>@Money(c.NetSales)</strong></Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="CashierSalesRowDto" Property="AverageBasket" Title="Avg basket" TextAlign="TextAlign.End"><Template Context="c">@Money(c.AverageBasket)</Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="CashierSalesRowDto" Title="" Width="75px" Sortable="false" TextAlign="TextAlign.Center">
                                <Template Context="c"><RadzenButton Icon="insights" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => ShowCashierInsightAsync(c))" /></Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                                break;
                            case "registers":
<RadzenDataGrid Data="@_report.SalesByRegister" TItem="RegisterSalesRowDto" AllowPaging="true" PageSize="20" AllowSorting="true" AllowFiltering="true" AllowColumnResize="true" ShowPagingSummary="true" EmptyText="No records match these filters.">
<Columns>
<RadzenDataGridColumn TItem="RegisterSalesRowDto" Property="StoreName" Title="Store" Width="170px" />
<RadzenDataGridColumn TItem="RegisterSalesRowDto" Property="RegisterName" Title="Register" Width="170px" />
<RadzenDataGridColumn TItem="RegisterSalesRowDto" Property="Transactions" Title="Transactions" Width="170px" TextAlign="TextAlign.End"><Template Context="row">@row.Transactions.ToString("N0")</Template></RadzenDataGridColumn>
<RadzenDataGridColumn TItem="RegisterSalesRowDto" Property="NetSales" Title="Sales before refunds" Width="170px" TextAlign="TextAlign.End"><Template Context="row">@Money(row.NetSales)</Template></RadzenDataGridColumn>
<RadzenDataGridColumn TItem="RegisterSalesRowDto" Property="CashSales" Title="Cash" Width="170px" TextAlign="TextAlign.End"><Template Context="row">@Money(row.CashSales)</Template></RadzenDataGridColumn>
<RadzenDataGridColumn TItem="RegisterSalesRowDto" Property="CardSales" Title="Card" Width="170px" TextAlign="TextAlign.End"><Template Context="row">@Money(row.CardSales)</Template></RadzenDataGridColumn>
<RadzenDataGridColumn TItem="RegisterSalesRowDto" Property="CreditSales" Title="Credit" Width="170px" TextAlign="TextAlign.End"><Template Context="row">@Money(row.CreditSales)</Template></RadzenDataGridColumn>
</Columns>
</RadzenDataGrid>
                                break;
                            case "hourly":
<RadzenDataGrid AllowPaging="true" PageSize="20" AllowSorting="true" AllowFiltering="true" AllowColumnResize="true" ShowPagingSummary="true" EmptyText="No records match these filters." Data="@_report.HourlySales" TItem="HourlySalesRowDto">
                        <Columns>
                            <RadzenDataGridColumn TItem="HourlySalesRowDto" Property="HourLabel" Title="Hour" />
                            <RadzenDataGridColumn TItem="HourlySalesRowDto" Property="Transactions" Title="Txns" Width="90px" TextAlign="TextAlign.Center" />
                            <RadzenDataGridColumn TItem="HourlySalesRowDto" Property="NetSales" Title="Net sales" TextAlign="TextAlign.End"><Template Context="h">@Money(h.NetSales)</Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="HourlySalesRowDto" Property="AverageBasket" Title="Avg basket" TextAlign="TextAlign.End"><Template Context="h">@Money(h.AverageBasket)</Template></RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                                break;
                            case "weekdays":
<RadzenDataGrid Data="@_report.WeekdaySales" TItem="WeekdaySalesRowDto" AllowPaging="true" PageSize="20" AllowSorting="true" AllowFiltering="true" AllowColumnResize="true" ShowPagingSummary="true" EmptyText="No records match these filters.">
<Columns>
<RadzenDataGridColumn TItem="WeekdaySalesRowDto" Property="DayName" Title="Weekday (UTC)" Width="170px" />
<RadzenDataGridColumn TItem="WeekdaySalesRowDto" Property="DaysInPeriod" Title="Days in range" Width="170px" TextAlign="TextAlign.End"><Template Context="row">@row.DaysInPeriod.ToString("N0")</Template></RadzenDataGridColumn>
<RadzenDataGridColumn TItem="WeekdaySalesRowDto" Property="Transactions" Title="Transactions" Width="170px" TextAlign="TextAlign.End"><Template Context="row">@row.Transactions.ToString("N0")</Template></RadzenDataGridColumn>
<RadzenDataGridColumn TItem="WeekdaySalesRowDto" Property="NetSales" Title="Net sales" Width="170px" TextAlign="TextAlign.End"><Template Context="row">@Money(row.NetSales)</Template></RadzenDataGridColumn>
<RadzenDataGridColumn TItem="WeekdaySalesRowDto" Property="AverageDailySales" Title="Average per day" Width="170px" TextAlign="TextAlign.End"><Template Context="row">@Money(row.AverageDailySales)</Template></RadzenDataGridColumn>
</Columns>
</RadzenDataGrid>
                                break;
                            case "products":
<RadzenDataGrid AllowPaging="true" PageSize="20" AllowSorting="true" AllowFiltering="true" AllowColumnResize="true" ShowPagingSummary="true" EmptyText="No records match these filters." Data="@_report.ProductPerformance" TItem="ProductSalesRowDto">
                        <Columns>
                            <RadzenDataGridColumn TItem="ProductSalesRowDto" Property="Sku" Title="SKU" Width="120px" />
                            <RadzenDataGridColumn TItem="ProductSalesRowDto" Property="ProductName" Title="Product" />
                            <RadzenDataGridColumn TItem="ProductSalesRowDto" Property="CategoryName" Title="Category" Width="150px" />
                            <RadzenDataGridColumn TItem="ProductSalesRowDto" Property="BrandName" Title="Brand" Width="140px" />
                            <RadzenDataGridColumn TItem="ProductSalesRowDto" Property="NetQuantity" Title="Net qty" Width="100px" TextAlign="TextAlign.End"><Template Context="p">@Qty(p.NetQuantity)</Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="ProductSalesRowDto" Property="Revenue" Title="Revenue" TextAlign="TextAlign.End"><Template Context="p">@Money(p.Revenue)</Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="ProductSalesRowDto" Property="Cost" Title="Cost" TextAlign="TextAlign.End"><Template Context="p">@Money(p.Cost)</Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="ProductSalesRowDto" Property="GrossProfit" Title="Profit" TextAlign="TextAlign.End"><Template Context="p"><span class="@(p.GrossProfit >= 0 ? "text-ok" : "text-warn")">@Money(p.GrossProfit)</span></Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="ProductSalesRowDto" Property="MarginPercent" Title="Margin" Width="90px" TextAlign="TextAlign.End"><Template Context="p">@Pct(p.MarginPercent)</Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="ProductSalesRowDto" Title="" Width="75px" Sortable="false" TextAlign="TextAlign.Center">
                                <Template Context="p"><RadzenButton Icon="insights" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => ShowProductInsightAsync(p))" /></Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                                break;
                            case "categories":
