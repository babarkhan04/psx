@page "/shifts"
@attribute [Authorize(Policy = Permissions.Operations.ShiftsView)]
@inject IShiftService ShiftService
@inject IStoreService StoreService
@inject IStoreContext StoreContext
@inject DialogService DialogService
@inject NotificationService Notifications

<PageTitle>Shifts & Cash · SmartPOS</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Shifts &amp; Cash</h1>
        <p class="page-subtitle">Open/close shifts, cash in/out, and X/Z reports.</p>
    </div>
    <div class="toolbar-actions">
        <RadzenDropDown @bind-Value="_storeId" Data="@_storeOptions" TextProperty="Text" ValueProperty="Value"
                        AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        Change="@(_ => LoadAsync())" Style="min-width:190px" Placeholder="All stores" />
        <RadzenCheckBox @bind-Value="_openOnly" Name="openOnly" @bind-Value:after="LoadAsync" />
        <RadzenLabel Text="Open only" Component="openOnly" Style="margin-right:0.5rem" />
        @if (_canOpen)
        {
            <RadzenButton Icon="play_arrow" Text="Open shift" Click="@OpenShiftAsync" />
        }
    </div>
</div>

@if (_activeShifts.Count > 0)
{
    <div class="kpi-grid">
        @foreach (var shift in _activeShifts)
        {
            <div class="kpi-card">
                <div class="kpi-top">
                    <span class="kpi-label">@shift.RegisterName · @shift.ShiftNumber</span>
                    <span class="status-pill on">Open</span>
                </div>
                <div class="kpi-value" style="font-size:1.1rem">@shift.OpeningFloat.ToString("C0") float</div>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.35rem" Style="margin-top:0.75rem;flex-wrap:wrap">
                    @if (_canCashMove)
                    {
                        <RadzenButton Icon="add" Text="Cash in/out" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                      Click="@(() => CashMoveAsync(shift.Id))" />
                        <RadzenButton Icon="lock_open" Text="No-sale" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                      Click="@(() => NoSaleDrawerAsync(shift.Id))" />
                    }
                    @if (_canClose)
                    {
                        <RadzenButton Icon="assessment" Text="X report" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                      Click="@(() => ViewReportAsync(shift.Id, "X report"))" />
                        <RadzenButton Icon="stop" Text="Close" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small"
                                      Click="@(() => CloseShiftAsync(shift))" />
                    }
                </RadzenStack>
            </div>
        }
    </div>
}

<RadzenCard class="content-card grid-card">
    <RadzenDataGrid Data="@_shifts" TItem="ShiftListItemDto" AllowSorting="true" AllowPaging="true"
                    PageSize="12" EmptyText="No shifts found." IsLoading="@_loading">
        <Columns>
            <RadzenDataGridColumn TItem="ShiftListItemDto" Property="ShiftNumber" Title="Shift #" Width="180px" />
            <RadzenDataGridColumn TItem="ShiftListItemDto" Property="OpenedOn" Title="Opened" Width="170px">
                <Template Context="s">@s.OpenedOn.ToLocalTime().ToString("dd MMM yyyy · h:mm tt")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ShiftListItemDto" Property="RegisterName" Title="Register" />
            <RadzenDataGridColumn TItem="ShiftListItemDto" Property="StoreName" Title="Store" />
            <RadzenDataGridColumn TItem="ShiftListItemDto" Property="OpenedByName" Title="Opened by" />
            <RadzenDataGridColumn TItem="ShiftListItemDto" Property="Status" Title="Status" Width="100px">
                <Template Context="s">
                    <span class="status-pill @(s.Status == "Open" ? "on" : "off")">@s.Status</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ShiftListItemDto" Property="OpeningFloat" Title="Float" Width="110px" TextAlign="TextAlign.End">
                <Template Context="s">@s.OpeningFloat.ToString("C0")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ShiftListItemDto" Property="Variance" Title="Variance" Width="110px" TextAlign="TextAlign.End">
                <Template Context="s">
                    @if (s.Status == "Closed")
                    {
                        <span class="@(s.Variance != 0 ? "text-warn" : "text-ok")">@s.Variance.ToString("C2")</span>
                    }
                    else { <span>—</span> }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ShiftListItemDto" Title="" Width="120px" Sortable="false" TextAlign="TextAlign.End">
                <Template Context="s">
                    <RadzenButton Icon="assessment" Text="@(s.Status == "Open" ? "X" : "Z")" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                  Click="@(() => ViewReportAsync(s.Id, s.Status == "Open" ? "X report" : "Z report"))" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</RadzenCard>

@code {
    private IReadOnlyList<ShiftListItemDto> _shifts = [];
    private IReadOnlyList<ShiftListItemDto> _activeShifts = [];
    private List<StoreOption> _storeOptions = [];
    private Guid? _storeId;
    private bool _openOnly;
    private bool _loading = true;
    private bool _canOpen;
    private bool _canClose;
    private bool _canCashMove;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private sealed record StoreOption(string Text, Guid? Value);

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            _canOpen = state.User.HasClaim(Permissions.ClaimType, Permissions.Operations.ShiftsOpen);
            _canClose = state.User.HasClaim(Permissions.ClaimType, Permissions.Operations.ShiftsClose);
            _canCashMove = state.User.HasClaim(Permissions.ClaimType, Permissions.Operations.ShiftsCashMove);
        }

        var stores = await StoreService.GetAllAsync(includeInactive: false);
        _storeOptions = [new("All stores", null), .. stores.Select(s => new StoreOption($"{s.Code} · {s.Name}", s.Id))];
        if (StoreContext.StoreId is { } selectedStore && stores.Any(s => s.Id == selectedStore))
        {
            _storeId = selectedStore;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        _shifts = await ShiftService.GetShiftsAsync(new ShiftQueryDto
        {
            StoreId = _storeId,
            OpenOnly = _openOnly,
            Take = 100
        });

        _activeShifts = _shifts.Where(s => s.Status == "Open").ToList();
        _loading = false;
    }

    private async Task OpenShiftAsync()
    {
        var opened = await DialogService.OpenAsync<OpenShiftDialog>(
            "Open shift",
            new Dictionary<string, object?>(),
            new DialogOptions { Width = "480px", CloseDialogOnOverlayClick = false });

        if (opened is true)
        {
            await LoadAsync();
            Notify("Shift opened", "You can now process sales on this register.", NotificationSeverity.Success);
        }
    }

    private async Task CloseShiftAsync(ShiftListItemDto shift)
    {
        var report = await ShiftService.GetReportAsync(shift.Id);
        var expected = report?.ExpectedCash ?? shift.OpeningFloat;

        var closed = await DialogService.OpenAsync<CloseShiftDialog>(
            $"Close shift · {shift.ShiftNumber}",
            new Dictionary<string, object?>
            {
                [nameof(CloseShiftDialog.ShiftId)] = shift.Id,
                [nameof(CloseShiftDialog.ShiftNumber)] = shift.ShiftNumber,
                [nameof(CloseShiftDialog.ExpectedCash)] = expected
            },
            new DialogOptions { Width = "520px", CloseDialogOnOverlayClick = false });

        if (closed is true)
        {
            await LoadAsync();
            Notify("Shift closed", "Cash counted and shift closed.", NotificationSeverity.Success);
        }
    }

    private async Task CashMoveAsync(Guid shiftId)
    {
        var saved = await DialogService.OpenAsync<CashMovementDialog>(
            "Cash in / out",
            new Dictionary<string, object?> { [nameof(CashMovementDialog.ShiftId)] = shiftId },
            new DialogOptions { Width = "440px", CloseDialogOnOverlayClick = false });

        if (saved is true)
        {
            await LoadAsync();
            Notify("Recorded", "Cash movement saved.", NotificationSeverity.Success);
        }
    }

    private async Task NoSaleDrawerAsync(Guid shiftId)
    {
        var saved = await DialogService.OpenAsync<NoSaleDrawerDialog>(
            "No-sale drawer open",
            new Dictionary<string, object?> { [nameof(NoSaleDrawerDialog.ShiftId)] = shiftId },
            new DialogOptions { Width = "460px", CloseDialogOnOverlayClick = false });

        if (saved is true)
        {
            await LoadAsync();
            Notify("No-sale recorded", "Drawer open reason saved for audit.", NotificationSeverity.Success);
        }
    }

    private async Task ViewReportAsync(Guid shiftId, string title)
    {
        var report = await ShiftService.GetReportAsync(shiftId);
        await DialogService.OpenAsync<ShiftReportDialog>(
            $"{title} · {report?.ShiftNumber}",
            new Dictionary<string, object?> { [nameof(ShiftReportDialog.Report)] = report },
            new DialogOptions { Width = "640px", CloseDialogOnOverlayClick = true });
    }

    private void Notify(string summary, string detail, NotificationSeverity severity) =>
        Notifications.Notify(new NotificationMessage { Severity = severity, Summary = summary, Detail = detail, Duration = 4000 });
}
