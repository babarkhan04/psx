    private async Task PayCash()
    {
        if (_context is null || _cart.Count == 0)
        {
            return;
        }

        var tendered = await DialogService.OpenAsync<PosCashDialog>(
            "Cash payment",
            CashCustomerParameters(),
            new DialogOptions { Width = "600px", CloseDialogOnOverlayClick = false });

        if (tendered is decimal amount)
        {
            await CompleteSale("Cash", amount);
        }
    }

    private async Task PayCard()
    {
        if (_context is null || _cart.Count == 0)
        {
            return;
        }

        await CompleteSale("Card", CartTotal);
    }

    private async Task PaySplit()
    {
        if (_context is null || _cart.Count == 0)
        {
            return;
        }

        var payments = await DialogService.OpenAsync<PosSplitPaymentDialog>(
            "Split payment",
            SplitCustomerParameters(),
            new DialogOptions { Width = "760px", CloseDialogOnOverlayClick = false });

        if (payments is List<PosPaymentLineDto> lines)
        {
            if (lines.Any(l => string.Equals(l.Method, "Credit", StringComparison.OrdinalIgnoreCase)) && _selectedCustomer is null)
            {
                NotifyWarn("Customer required", "Select a customer before using credit/udhaar in split payment.");
                return;
            }

            await CompleteSale("Split", CartTotal, lines);
        }
    }

    private async Task CompleteSale(string method, decimal amountTendered, IList<PosPaymentLineDto>? paymentLines = null)
    {
        if (_context is null)
        {
            return;
        }

        _busy = true;
        var checkout = new PosCheckoutDto
        {
            StoreId = _context.StoreId,
            RegisterId = _context.RegisterId,
            CustomerId = _selectedCustomerId,
            CustomerName = _customerName,
            PaymentMethod = method,
            AmountTendered = amountTendered,
            InvoiceDiscountAmount = CartInvoiceDiscount,
            DiscountReason = _invoiceDiscountReason,
            HeldSaleId = _activeHeldSaleId,
            ManagerApprovalId = _invoiceDiscountApprovalId,
            Lines = _cart.ToList(),
            Payments = paymentLines?.ToList() ?? []
        };

        var result = await PosService.CompleteSaleAsync(checkout);
        _busy = false;

        if (!result.Succeeded || result.Data is null)
        {
            Notifications.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Sale failed",
                Detail = result.Error ?? "Could not complete sale.",
                Duration = 5000
            });
            return;
        }

        _lastReceipt = result.Data;
        ShowReceiptOnCustomerDisplay(result.Data);
        _cart.Clear();
        _selectedCartIndex = null;
        _selectedCustomerBirthday = false;
        _selectedCustomerId = null;
        _selectedCustomer = null;
        _customerName = "Walk-In Customer";
        _activeHeldSaleId = null;
        _activeHeldSaleNumber = null;
        _customers = (await CustomerService.SearchLookupAsync(null, take: 200)).ToList();
        await ReloadProducts();

        await DialogService.OpenAsync<PosReceiptDialog>(
            "Receipt",
            new Dictionary<string, object?> { [nameof(PosReceiptDialog.Receipt)] = result.Data },
            new DialogOptions { Width = "480px", CloseDialogOnOverlayClick = false });

        try { await _scanInput.FocusAsync(); } catch { /* ok */ }
    }


    private async Task TogglePosLockModeAsync()
    {
        _posLockMode = !_posLockMode;
        if (_keyboardModule is not null)
        {
            try
            {
                await _keyboardModule.InvokeVoidAsync("setPosLockMode", _posLockMode);
            }
            catch
            {
                NotifyWarn("POS lock", "Full-screen mode was blocked by the browser, but POS focus mode was applied.");
            }
        }

        StateHasChanged();
    }

    private async Task OpenCustomerDisplayAsync()
    {
        if (_context is null)
        {
            NotifyWarn("Customer display", "Open a register first.");
            return;
        }

        _customerDisplayUrl ??= $"/customer-display/{_context.RegisterId}";
        UpdateCustomerDisplay();

        if (_keyboardModule is not null)
        {
            try
            {
                await _keyboardModule.InvokeVoidAsync("openWindow", _customerDisplayUrl);
                return;
            }
            catch
            {
                // Fall back to same-tab navigation if popup opening is blocked.
            }
        }

        Navigation.NavigateTo(_customerDisplayUrl);
    }

    private void UpdateCustomerDisplay()
    {
        if (_context is null)
        {
            return;
        }

        CustomerDisplayState.Set(new CustomerDisplayStateDto
        {
            RegisterId = _context.RegisterId,
            StoreName = _context.StoreName,
            RegisterName = _context.RegisterName,
            CustomerName = _customerName,
            Status = _cart.Count == 0 ? "Ready" : "In progress",
            ItemCount = (int)Math.Round(_cart.Sum(x => x.Quantity), 0),
            Subtotal = CartGrossSubtotal,
            DiscountAmount = CartDiscountTotal,
            TaxAmount = CartTax,
            TotalAmount = CartTotal,
            Lines = _cart.Select(x => new CustomerDisplayLineDto
            {
                Sku = x.Sku,
                Name = x.Name,
                Quantity = x.Quantity,
                UnitPrice = x.UnitPrice,
                LineTotal = x.LineTotal
            }).ToList()
        });
    }

    private void ShowReceiptOnCustomerDisplay(PosReceiptDto receipt)
    {
        if (_context is null)
        {
            return;
        }

        CustomerDisplayState.Set(new CustomerDisplayStateDto
        {
            RegisterId = _context.RegisterId,
            StoreName = receipt.StoreName,
            RegisterName = receipt.RegisterName,
            CustomerName = receipt.CustomerName,
            Status = "Sale complete",
            SaleNumber = receipt.SaleNumber,
            ItemCount = (int)Math.Round(receipt.Lines.Sum(x => x.Quantity), 0),
            Subtotal = receipt.Subtotal,
            DiscountAmount = receipt.DiscountAmount,
            TaxAmount = receipt.TaxAmount,
            TotalAmount = receipt.TotalAmount,
            Lines = receipt.Lines.Select(x => new CustomerDisplayLineDto
            {
                Sku = x.Sku,
                Name = x.Name,
                Quantity = x.Quantity,
                UnitPrice = x.UnitPrice,
                LineTotal = x.LineTotal
            }).ToList()
        });
    }

    private void NotifyWarn(string summary, string detail) =>
        Notifications.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Warning,
            Summary = summary,
            Detail = detail,
            Duration = 3500
        });

    public async ValueTask DisposeAsync()
    {
        if (_keyboardModule is not null)
        {
            try
            {
                await _keyboardModule.InvokeVoidAsync("setPosLockMode", false);
                await _keyboardModule.InvokeVoidAsync("dispose");
                await _keyboardModule.DisposeAsync();
            }
            catch { /* circuit gone */ }
        }
        _productSearchDebounceCts?.Cancel();
        _productSearchDebounceCts?.Dispose();
        _dotNetRef?.Dispose();
    }
